[Server]
Listen = ":9100"

[Push]
Endpoint = ""        # e.g. "https://push.topsrv.io/v1/write" or VM direct
Token    = ""        # Bearer token for auth
Interval = "30s"
SpoolDir = ""        # disk buffer for retries, e.g. "/var/lib/topsrv/spool"

[Update]
Enabled  = false         # set true to enable auto-update via control plane
Interval = "15m"         # check interval
Channel  = "stable"      # stable / beta

# PostgreSQL (optional — auto-discovery detects the process, DSN needed for connection)
# [Postgres]
# DSN = "postgres://topsrv:pass@localhost:5432/postgres?sslmode=disable"
# Disabled = true  # skip PG monitoring even if discovery finds a local postgres process

# Nginx (optional — auto-discovery parses nginx.conf automatically)
# [Nginx]
# StubStatusURL = "http://127.0.0.1/stub_status"
# LogFormat     = '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" $request_time $upstream_response_time'
# ExtraLabels   = ["server_name"]
# AccessLogs    = ["/var/log/nginx/access.log"]

# Angie (optional — auto-discovery parses angie.conf automatically)
# [Angie]
# StatusURL     = "http://127.0.0.1:8080/status/"    # JSON API URL
# StubStatusURL = "http://127.0.0.1/stub_status"     # fallback if no API
# LogFormat     = '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" $request_time $upstream_response_time'
# ExtraLabels   = ["server_name"]
# AccessLogs    = ["/var/log/angie/access.log"]

# Package inventory (optional — auto-discovery detects dpkg/rpm/apk via files).
# Sends a periodic snapshot to /v1/inventory with kind="packages".
# On /metrics only aggregates are exposed (counts, upgradable, scan duration).
# [Packages]
# Disabled       = false      # set true to fully skip the collector
# Interval       = "6h"       # snapshot scan period (±10% jitter to avoid herds)
# Managers       = []         # auto-detect by default; e.g. ["dpkg","rpm"] to force a subset
# DisablePush    = false      # set true to skip POSTing snapshots to /v1/inventory (kept on /metrics aggregates)
# MaxPackages    = 10000      # safety cap; logs a warning and truncates if exceeded
# CheckUpgrades  = false      # (Phase 4, not wired yet) — will populate topsrv_packages_upgradable from local apt/dnf cache

# Bot-logs ingest to topsrv.io (optional — ships bot traffic events for analytics).
# When enabled, botlog reads four nginx variables (http_user_agent, server_name,
# remote_addr, http_referer) from each access-log line. These are NOT added to
# Prometheus labels — your [Nginx]/[Angie] ExtraLabels stay exactly as you set
# them (keep them low-cardinality: server_name, http_platform, http_version).
# Endpoint defaults to [Push].Endpoint with the path replaced by /v1/bot-logs.
# SpoolDir defaults to [Push].SpoolDir; bot-log files live in a "botlog/" subdir
# so they don't collide with the metrics push spool.
# [BotLogs]
# Enabled       = true
# Token         = ""        # required — issued by topsrv.io per project
# Endpoint      = ""        # default: derived from [Push].Endpoint
# BatchSize     = 5000      # events per batch
# BatchInterval = "30s"     # flush interval
# SpoolDir      = ""        # default: [Push].SpoolDir
# MaxSpoolMB    = 200       # WAL disk budget
# UATruncate    = 1024      # truncate user-agent at this length
# URITruncate   = 2048      # truncate request URI at this length
# ExtraUAPatterns = ["MyCustomCrawler/"]  # local additions to the bot list
# Field aliases — override only if discovery cannot infer the right name
# (e.g. nginx `set $custom $http_referer;` puts $custom in your log_format).
# Empty entries fall back to auto-detected, then to default nginx variable.
# [BotLogs.FieldAliases]
# Referer = "ref"
# UserAgent = ""

# Web-logs ingest to topsrv.io (optional — ships the full HTTP stream from the
# access logs you name, not just bot traffic).
#
# Where [BotLogs] sends only lines whose user agent matched the built-in list,
# this stream sends everything from the files listed in LogPaths. The UA
# classifier still runs, but as a signal on the event (uaMatched) rather than a
# gate — a scraper on a plain browser UA never appears in the bot stream at all.
#
# LogPaths is an explicit allowlist, and it has no default: naming files is the
# cheapest filter there is, and it is the only one that cannot accidentally pick
# up a log added later whose log_format carries request bodies. Globs are
# refused for the same reason. Every path must also appear in your
# [Nginx]/[Angie] AccessLogs — this stream reads the collector's tail, it does
# not open files of its own.
#
# Before tailing, each path's log_format is checked. A format carrying
# $request_body, $http_cookie or $http_authorization is refused outright, as is
# one with no client address, no $status or no URI variable. Missing timestamp,
# method or $upstream_response_time only warn. Every refusal and warning is
# logged at startup and ticks topsrv_collector_config_warnings_total{kind=...}.
#
# Volume is the thing to plan for: a front node produces one line per request,
# so expect three to four orders of magnitude more events than the bot stream.
# The filters below are what keep that in hand — RequireUpstream alone typically
# removes most of a front node's traffic, since bundles, images and static files
# never reach a backend.
#
# Token must differ from [BotLogs].Token: separate tokens are what make the two
# streams separately revocable. Endpoint defaults to [Push].Endpoint with the
# path replaced by /v1/web-logs; SpoolDir defaults to [Push].SpoolDir with a
# "weblog/" subdir, so a burst on one stream cannot evict the other's batches.
# [WebLogs]
# Enabled         = true
# Token           = ""        # required — must differ from [BotLogs].Token
# Endpoint        = ""        # default: derived from [Push].Endpoint
# LogPaths        = ["/var/log/nginx/site.access.log"]  # required; absolute, no globs
# RequireUpstream = true      # keep only requests that reached a backend
# Upstreams       = []        # allowlist of $proxy_host values; needs $proxy_host in log_format
# ExcludePathPrefixes = ["/static/", "/_build/"]  # matched against the raw path
# BatchSize       = 5000      # events per batch
# BatchInterval   = "30s"     # flush interval
# SpoolDir        = ""        # default: [Push].SpoolDir + "/weblog"
# MaxSpoolMB      = 200       # WAL disk budget, separate from the bot-log one
# UATruncate      = 1024      # truncate user-agent at this length
# URITruncate     = 2048      # truncate request URI at this length
